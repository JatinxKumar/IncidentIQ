# IncidentIQ Backend — Environment Variables Reference
# =====================================================
# Copy this file to .env for local development.
# Production values are injected via Replit Secrets.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=DEBUG

# ─── Database ─────────────────────────────────────────────────────────────────
# Auto-provisioned by Replit. For local dev, point to your local PostgreSQL.
# Standard postgresql:// format — the app auto-converts to asyncpg dialect.
DATABASE_URL=postgresql://user:password@localhost:5432/incidentiq

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development: allow all origins
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://incidentiq.replit.app,http://localhost:5173

# ─── Security (Module 6 — Authentication) ────────────────────────────────────
# Generate a strong random secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-before-deploying-to-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Internal Services ────────────────────────────────────────────────────────
API_SERVER_URL=http://localhost:5000

# ─── Model Storage ────────────────────────────────────────────────────────────
MODEL_STORE_PATH=./trained_models

# ─── ML Training Defaults ─────────────────────────────────────────────────────
DEFAULT_TEST_SIZE=0.2
DEFAULT_RANDOM_STATE=42
DEFAULT_CV_FOLDS=5
